# Required for LLM features
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
APP_ENV=development

# ReachAI run limits
REACHAI_DAILY_LIMIT=5
REACHAI_MIN_SCORE=75
REACHAI_MAX_RETRIES=2

# Gmail OAuth production settings
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json
GMAIL_SCOPES="https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.modify"

# Optional: used if you add local storage overrides
# REACHAI_DB_PATH=./data/reachai.db
