# Drafts are written by Claude Code (`claude -p`, your existing login, no API key).
# Options: claude-code | openrouter (needs OPENROUTER_API_KEY) | none (template only)
REACHAI_LLM_BACKEND=claude-code
REACHAI_CLAUDE_MODEL=sonnet
# Optional, only for REACHAI_LLM_BACKEND=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
APP_ENV=development

# ReachAI run limits
REACHAI_DAILY_LIMIT=5
REACHAI_MIN_SCORE=75
REACHAI_MAX_RETRIES=2
REACHAI_DB_PATH=./data/reachai.db
REACHAI_CANDIDATE_PATH=./data/candidate.json

# Safe default: completes the workflow without sending external email.
# Change to "gmail" only after OAuth credentials are configured and verified.
REACHAI_SEND_MODE=dry-run
REACHAI_HOST=127.0.0.1
REACHAI_PORT=8000

# Gmail OAuth production settings
GMAIL_CREDENTIALS_PATH=./secrets/credentials.json
GMAIL_TOKEN_PATH=./secrets/token.json
GMAIL_SCOPES="https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.modify"

# Apollo.io people search (master key, or enable people api_search, people match, job_postings)
APOLLO_API_KEY=
REACHAI_ENRICH_PER_RUN=10
# Where Approve/Reject buttons point; empty means http://127.0.0.1:8000
REACHAI_PUBLIC_URL=
